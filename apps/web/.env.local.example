# =============================================================================
# Supabase
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Necessário apenas para `npm run db:migrate:cloud`
# SUPABASE_ACCESS_TOKEN=your-personal-access-token
# SUPABASE_DB_PASSWORD=your-database-password

# =============================================================================
# App — identidade e regras de negócio
# =============================================================================
NEXT_PUBLIC_NOME_EMPRESA=Pão Quente
NEXT_PUBLIC_NOME_APP=SWM - CRM
NEXT_PUBLIC_CMV_ALVO_PADRAO=30
NEXT_PUBLIC_MARGEM_AMARELA_PP=5
NEXT_PUBLIC_DESENVOLVEDOR_NOME=BroTech
NEXT_PUBLIC_DESENVOLVEDOR_CNPJ=36.319.268/0001-38
NEXT_PUBLIC_DESENVOLVEDOR_CONTATO=+55 38 2200-0600

# =============================================================================
# Feature flags — habilite/desabilite módulos durante o desenvolvimento
# Opção 1: flags individuais (padrão: true)
# NEXT_PUBLIC_FEATURE_PDV=true
# NEXT_PUBLIC_FEATURE_PRODUTOS=true
# NEXT_PUBLIC_FEATURE_ESTOQUE=true
# NEXT_PUBLIC_FEATURE_FINANCEIRO=true

# Opção 2: lista de módulos ativos (sobrescreve as flags individuais)
# NEXT_PUBLIC_ENABLED_MODULES=pdv,produtos,estoque,financeiro

# =============================================================================
# PDV — impressão de cupom fiscal
# =============================================================================
# Tamanho do papel térmico: 80mm ou 58mm
NEXT_PUBLIC_PDV_TAMANHO_PAPEL=80mm
# Modo de impressão: agente (silenciosa) ou navegador (abre diálogo)
NEXT_PUBLIC_PDV_MODO_IMPRESSAO=agente
# URL do agente local de impressão (apps/print-agent)
NEXT_PUBLIC_PDV_PRINT_AGENT_URL=http://127.0.0.1:9333
# Nome padrão da impressora (opcional — pode ser definido em Configurações)
# NEXT_PUBLIC_PDV_NOME_IMPRESSORA=EPSON TM-T20 Receipt
# Imprime automaticamente após concluir a venda
NEXT_PUBLIC_PDV_IMPRIMIR_CUPOM_AUTOMATICO=true
# Mensagem exibida no rodapé do cupom
NEXT_PUBLIC_PDV_MENSAGEM_RODAPE=Obrigado pela preferência!

# =============================================================================
# Desenvolvimento
# =============================================================================
# Força dados mock mesmo com Supabase configurado
# USE_MOCK_DATA=true

# Logs de debug (padrão: true em development)
# DEBUG=true
