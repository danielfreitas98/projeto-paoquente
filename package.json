{
  "name": "projeto-paoquente",
  "version": "0.1.0",
  "private": true,
  "description": "CRM + Gestão Financeira para Padarias e Casas de Café",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "print-agent": "npm run dev --workspace=apps/print-agent",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up",
    "db:types": "supabase gen types typescript --local > apps/web/src/types/database.ts",
    "db:migrate:cloud": "node scripts/apply-migrations-cloud.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "pg": "^8.21.0"
  }
}
