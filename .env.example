# Supabase (local ou cloud)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Next.js (apps/web) — copie para apps/web/.env.local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Configurações da aplicação (ver apps/web/.env.local.example para lista completa)
NEXT_PUBLIC_NOME_EMPRESA=Pão Quente
NEXT_PUBLIC_CMV_ALVO_PADRAO=30
